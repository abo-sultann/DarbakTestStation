<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_screen" android:layoutDirection="rtl">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="الإعدادات" android:textSize="28sp" android:textStyle="bold" android:textColor="#171717"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تخصيص محطة الاختبار وسلوك الفحص" android:textSize="15sp" android:textColor="#6D6A64" android:paddingBottom="18dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_card">
<Switch android:id="@+id/strictT3" android:layout_width="match_parent" android:layout_height="54dp" android:text="تفعيل بوابة T3 الصارمة" android:textSize="17sp" android:checked="true"/>
<Switch android:id="@+id/showTechnical" android:layout_width="match_parent" android:layout_height="54dp" android:text="إظهار التفاصيل التقنية في التقرير" android:textSize="17sp" android:checked="true"/>
<Switch android:id="@+id/keepHistory" android:layout_width="match_parent" android:layout_height="54dp" android:text="حفظ سجل الاختبارات محليًا" android:textSize="17sp" android:checked="true"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ملف T3 المعتمد: Android 7.1 / API 25 • 1024×600 • Landscape • ARM Cortex-A7 • RAM محدودة" android:textColor="#6D6A64" android:textSize="14sp" android:paddingTop="12dp"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="24dp" android:text="أبوسلطان  •  Darbak Test Station" android:textColor="#B68A35" android:textStyle="bold"/>
</LinearLayout></ScrollView>